  m_Script: {fileID: 11500000, guid: e3f81c2d18ff1f0419af56d68879b0b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uB77C\uCFE4"
  lines:
  - "\uD5C9... \uD5C9..."
  - "\uBB50\uC57C, \uC2E0\uC785\uC774\uC57C? \uC800\uCABD\uC5D0 \uC788\uB294 \uC641\uC2A4\uB098
    \uB0A0\uB77C.\r\n"
  - "...\uBB50? \uC77C\uD558\uB7EC \uC628 \uAC8C \uC544\uB2C8\uB77C\uACE0?\r\n"
  - "\uC5EC\uAE30\uC5D0\uC11C \uB098\uAC00\uACA0\uB2E4\uACE0? \uAFC8\uB3C4 \uD06C\uB124.
    \uC7A1\uD788\uBA74 \uBC14\uB85C \uD3C9\uC0DD \uC641\uC2A4\uB098 \uB098\uB974\uBA74\uC11C
    \uC0B4\uC544\uC57C \uD574.\r\n"
  - "\uB098\uB3C4 \uB538\uC560\uD55C\uD14C \uC904 \uC641\uBFCC\uBCFC \uD558\uB098
    \uCC59\uAE30\uB824\uB2E4\uAC00 \uC774\uB807\uAC8C...\r\n"
  - "\uC544\uBB34\uD2BC, \uC815\uB9D0 \uB098\uAC00\uACE0 \uC2F6\uC73C\uBA74 \uC815\uBB38
    \uC5F4\uC1E0\uBD80\uD130 \uCC3E\uC544.\r\n"
  - "\uC544\uB9C8 2\uCE35 \uC0AC\uBB34\uC2E4\uC5D0 \uC788\uC744 \uAC70\uC57C. \uBE44\uBC00\uBC88\uD638\uB294
    0808\uC774\uB2E4.\r\n"
  - "\uC790, \uC774\uC81C \uB410\uC9C0? \uB3C4\uC640\uC904 \uAC70 \uC544\uB2C8\uBA74
    \uC800\uB9AC \uAC00! \uD5C9... \uD5C9... \r\n"
  dialogueFont: {fileID: 11400000, guid: 3360d698cc1dfbb46a3f88d519426c21, type: 2}
