--- !u!114 &6494388287189774798
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2860201810518140566}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e3f81c2d18ff1f0419af56d68879b0b0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  npcName: "\uD584\uC2A4\uD130"
  lines:
  - "(\uD584\uC2A4\uD130\uAC00 \uC641\uBFCC\uBCFC\uC744 \uC9D1\uC911\uD574\uC11C
    \uBD80\uC218\uACE0 \uC788\uB2E4.)\r\n"
  - "\uD788\uD788... \uC7AC\uBC0C\uB2E4... \uB108\uBB34 \uC7AC\uBC0C\uC5B4...\r\n"
  - "\uC751? \uBB50\uC57C, \uAE30\uB2C8\uD53C\uADF8\uC796\uC544?\r\n"
  - "\uBBF8\uB9AC \uB9D0\uD574\uB450\uB294\uB370, \uC5EC\uAE30 \uC788\uB294 \uC641\uBFCC\uBCFC\uC740
    \uC804\uBD80 \uB0B4 \uAC70\uC57C! \uC800\uB9AC \uAC00!\r\n"
  - "...\uBB50? \uC5EC\uAE30\uC11C \uB098\uAC00\uACE0 \uC2F6\uB2E4\uACE0?\r\n"
  - "\uC774\uB807\uAC8C \uC88B\uC740 \uCC9C\uAD6D\uC744 \uB450\uACE0 \uB098\uAC00\uACA0\uB2E4\uB2C8,
    \uBCC4\uB09C \uB140\uC11D\uC774\uB124.\r\n"
  - "\uBB50, \uB9C8\uC74C\uB300\uB85C \uD574. \uC5B4\uCC28\uD53C \uB098\uAC00\uB294
    \uBB38\uC740 \uC7A0\uACA8 \uC788\uC73C\uB2C8\uAE4C. \uB098\uAC00\uB824\uBA74
    \uC5F4\uC1E0\uAC00 \uD544\uC694\uD560\uAC78?\r\n"
  - "\uC790, \uC54C\uB824\uC92C\uC73C\uB2C8\uAE4C \uC774\uC81C \uC800\uB9AC \uAC00!\r\n"
  - "(\uBF40\uC791... \uBF40\uC791...) \uD788\uD788\uD788...\r\n"
  dialogueFont: {fileID: 11400000, guid: b8d81840b19172e4bb10f91262afe39d, type: 2}
